# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube a GitHub.

DEBUG=True

# Generar una clave propia (mínimo 32 caracteres) con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-segura-generada-con-el-comando-de-arriba

ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: sqlite para desarrollar. En Docker se usa postgresql con las variables DB_*.
DB_ENGINE=sqlite
# DB_NAME=pedidos
# DB_USER=pedidos
# DB_PASSWORD=pedidos
# DB_HOST=127.0.0.1
# DB_PORT=5432

# URLs base de los otros servicios (spec.md, sección 1)
INVENTARIO_API_URL=http://127.0.0.1:3000/api
PAGOS_API_URL=http://127.0.0.1:8001/api
